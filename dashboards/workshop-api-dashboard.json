{
  "dashboard": {
    "title": "Workshop API - Observabilité",
    "tags": ["workshop", "api", "s7"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Requêtes par seconde (RPS)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"workshop\"}[5m]))",
            "legendFormat": "Total RPS"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requêtes/s"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Taux d'erreurs (5xx)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"workshop\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{namespace=\"workshop\"}[5m])) * 100",
            "legendFormat": "% Erreurs 5xx"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Taux d'erreur"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 1, "colorMode": "critical", "fill": true, "line": true, "op": "gt"}
        ]
      },
      {
        "id": 3,
        "title": "Latence p50, p95, p99",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=\"workshop\"}[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=\"workshop\"}[5m])) by (le))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"workshop\"}[5m])) by (le))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latence"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 0.3, "colorMode": "critical", "fill": false, "line": true, "op": "gt"}
        ]
      },
      {
        "id": 4,
        "title": "Saturation CPU",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"workshop\",container!=\"\"}[5m])) by (pod)",
            "legendFormat": "{{ pod }}"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "CPU Usage"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 0.8, "colorMode": "critical", "fill": true, "line": true, "op": "gt"}
        ]
      },
      {
        "id": 5,
        "title": "Saturation Mémoire",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=\"workshop\",container!=\"\"}) by (pod) / sum(kube_pod_container_resource_limits{namespace=\"workshop\",resource=\"memory\"}) by (pod)",
            "legendFormat": "{{ pod }}"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Memory Usage"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 0.8, "colorMode": "critical", "fill": true, "line": true, "op": "gt"}
        ]
      },
      {
        "id": 6,
        "title": "Nombre de pods Running",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"workshop\",phase=\"Running\"})"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 7,
        "title": "Redémarrages de pods (10min)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 16},
        "targets": [
          {
            "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"workshop\"}[10m]))"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value",
          "textMode": "value_and_name"
        },
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {"value": 0, "color": "green"},
            {"value": 3, "color": "yellow"},
            {"value": 5, "color": "red"}
          ]
        }
      },
      {
        "id": 8,
        "title": "Logs récents (Loki)",
        "type": "logs",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "{namespace=\"workshop\"}",
            "refId": "A",
            "datasource": "Loki"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "sortOrder": "Descending"
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
    }
  },
  "overwrite": true
}

